# /etc/systemd/system/cnabstudio-api.service
[Unit]
Description=CNAB Studio - backend do assistente de IA
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/cnab-studio/cnab-sudio/server
ExecStart=/usr/bin/env npm start
Restart=on-failure
RestartSec=5
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
